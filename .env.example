# Required: your Nebius Token Factory API key (https://tokenfactory.nebius.com -> API keys)
NEBIUS_API_KEY=

# Optional: OpenAI-compatible endpoint (default below). Some accounts use a regional URL,
# e.g. https://api.tokenfactory.us-central1.nebius.com/v1/
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Optional: default chat model (switchable in the UI sidebar)
BESTIE_DEFAULT_MODEL=nvidia/Nemotron-3_5-Lightning

# Optional: cheaper model for background work (summaries, drafts, skills). Empty = use the chat model.
BESTIE_UTILITY_MODEL=

# Optional: add/rename models without code changes: "Label=model/id,Label2=model/id2"
BESTIE_EXTRA_MODELS=

# Optional: where the local SQLite memory file lives
# BESTIE_DB_PATH=./data/bestie.db
